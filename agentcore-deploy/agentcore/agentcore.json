{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ManifestSwarm",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ManifestSwarm"
  },
  "runtimes": [
    {
      "name": "ManifestOrchestrator",
      "description": "Manifest's trust-and-safety and pricing tools, hosted on Bedrock AgentCore",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ManifestOrchestrator/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "MANIFEST_MODEL_PROVIDER",
          "value": "bedrock_mantle"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "MANIFEST_OUTREACH_GUARDRAIL_ID",
          "value": "tg655iizlour"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "guardrail-policy.json",
        "invoke-vetting-agent-policy.json"
      ],
      "connections": [
        {
          "id": "shipmentMemory",
          "to": {
            "type": "memory",
            "arn": "arn:aws:bedrock-agentcore:us-east-1:507041536887:memory/ManifestSwarm_ManifestShipmentMemory-eoutBk9J2E"
          },
          "access": "readwrite",
          "description": "Per-shipment continuity across the load lifecycle"
        },
        {
          "id": "vettingRuntime",
          "to": {
            "type": "runtime",
            "arn": "arn:aws:bedrock-agentcore:us-east-1:507041536887:runtime/ManifestSwarm_CarrierVettingAgent-Kl247v61N0",
            "exec": true
          },
          "description": "Delegates carrier vetting to the standalone Carrier Vetting Agent runtime"
        }
      ]
    },
    {
      "name": "CarrierVettingAgent",
      "description": "Standalone Carrier Vetting & Fraud Detection Agent, invoked by the Orchestrator as a genuine cross-runtime call",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CarrierVettingAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        { "name": "MANIFEST_MODEL_PROVIDER", "value": "bedrock_mantle" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": ["mantle-policy.json"]
    }
  ],
  "memories": [
    {
      "name": "ManifestShipmentMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        }
      ],
      "indexedKeys": [
        {
          "key": "loadId",
          "type": "STRING"
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}